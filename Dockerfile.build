# Build stage untuk CI/CD pipeline
# Digunakan di GitHub Actions atau CI lainnya

FROM golang:alpine AS builder

RUN apk add --no-cache git

WORKDIR /app

# Cache modules layer
COPY go.mod go.sum ./
RUN go mod download

# Source code
COPY . .

# Cross-compile untuk linux/amd64
ARG GOOS=linux
ARG GOARCH=amd64
ENV CGO_ENABLED=0
RUN go build -o manager ./cmd/api/main.go

# Final image
FROM alpine:3.20

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /root/

COPY --from=builder /app/manager .

RUN mkdir -p /root/logs

EXPOSE 8080

CMD ["./manager"]
